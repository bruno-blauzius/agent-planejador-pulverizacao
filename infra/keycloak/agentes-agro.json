{
  "product": "agentes-agro",
  "realm": "inceres",
  "productClient": "agentes-agro",
  "clients": [
    {
      "clientId": "agentes-agro",
      "name": "Agentes Agro",
      "description": "Login do Agentes Agro. A services/api é o cliente OIDC (padrão BFF) e emite o cookie de sessão; ADR 0015, D6.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${AGENTES_AGRO_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "consentRequired": false,
      "rootUrl": "${WEB_URL}",
      "baseUrl": "/",
      "redirectUris": [
        "${API_URL}/auth/callback",
        "${API_URL}/auth/login"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "${API_INTERNAL_URL}/auth/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false",
        "require.pushed.authorization.requests": "false",
        "access.token.signed.response.alg": "RS256",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-agentes-agro",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "agentes-agro",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "client-roles-agentes-agro",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "agentes-agro",
            "claim.name": "resource_access.agentes-agro.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ],
      "adminUrl": ""
    },
    {
      "clientId": "agentes-agro-provisioner",
      "name": "Agentes Agro: provisionador",
      "description": "Conta de serviço da API para provisionar usuários (conta, grupo, sessões); ADR 0015, D5.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PROVISIONER_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "consentRequired": false,
      "redirectUris": [],
      "webOrigins": [],
      "adminUrl": "",
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false",
        "require.pushed.authorization.requests": "false",
        "access.token.signed.response.alg": "RS256",
        "client_credentials.use_refresh_token": "false",
        "access.token.lifespan": "120"
      }
    }
  ],
  "serviceAccountRoles": [
    {
      "client": "agentes-agro-provisioner",
      "target": "realm-management",
      "roles": [
        "manage-users",
        "view-users"
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "agentes-agro-provisioner",
      "target": "realm-management",
      "roles": [
        "manage-users",
        "view-users"
      ]
    }
  ],
  "clientScopes": [
    {
      "client": "agentes-agro",
      "default": [
        "acr",
        "profile",
        "basic",
        "email"
      ],
      "optional": []
    },
    {
      "client": "agentes-agro-provisioner",
      "default": [
        "service_account",
        "basic",
        "kc-admin-api"
      ],
      "optional": []
    }
  ],
  "permissions": [
    {
      "name": "dashboard.view",
      "description": "Ver o Painel do administrador"
    },
    {
      "name": "companies.manage",
      "description": "Gerenciar empresas clientes (super admin)"
    },
    {
      "name": "users.manage",
      "description": "Gerenciar usuários e convites da própria empresa"
    },
    {
      "name": "users.manage_all",
      "description": "Gerenciar usuários de todas as empresas (super admin)"
    },
    {
      "name": "registry.write",
      "description": "Criar e editar fazendas, talhões e proprietários"
    },
    {
      "name": "applications.register",
      "description": "Registrar aplicações"
    },
    {
      "name": "applications.confirm",
      "description": "Confirmar aplicações"
    },
    {
      "name": "planner.use",
      "description": "Usar o Planejador e o agente"
    },
    {
      "name": "field_conditions.record",
      "description": "Lançar leituras de pluviômetro e vistorias do solo do talhão"
    }
  ],
  "profiles": [
    {
      "name": "super_admin",
      "description": "Super administrador: sistema, empresas e usuários de todas as empresas",
      "permissions": [
        "dashboard.view",
        "companies.manage",
        "users.manage",
        "users.manage_all",
        "registry.write",
        "applications.register",
        "applications.confirm",
        "planner.use",
        "field_conditions.record"
      ]
    },
    {
      "name": "admin",
      "description": "Administrador: gerencia a própria empresa, os cadastros e os usuários, e confirma aplicações",
      "permissions": [
        "dashboard.view",
        "users.manage",
        "registry.write",
        "applications.register",
        "applications.confirm",
        "planner.use",
        "field_conditions.record"
      ]
    },
    {
      "name": "planning_operator",
      "description": "Operador de planejamento: usa o Planejador e registra aplicações nas fazendas liberadas",
      "permissions": [
        "applications.register",
        "planner.use",
        "field_conditions.record"
      ]
    }
  ],
  "groups": [
    {
      "path": "/agentes-agro"
    },
    {
      "path": "/agentes-agro/super-admins",
      "role": "super_admin"
    },
    {
      "path": "/agentes-agro/admins",
      "role": "admin"
    },
    {
      "path": "/agentes-agro/planning-operators",
      "role": "planning_operator"
    }
  ],
  "realmRequirements": {
    "equals": {
      "registrationAllowed": false,
      "verifyEmail": true,
      "duplicateEmailsAllowed": false,
      "eventsEnabled": true,
      "adminEventsEnabled": true,
      "bruteForceProtected": true
    },
    "oneOf": {
      "sslRequired": [
        "external",
        "all"
      ]
    },
    "passwordPolicy": {
      "minLength": 8,
      "required": [
        "digits",
        "lowerCase"
      ]
    },
    "warnWhenNot": {
      "revokeRefreshToken": true,
      "adminPermissionsEnabled": true
    }
  }
}
