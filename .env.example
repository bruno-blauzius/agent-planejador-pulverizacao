# Copie para .env e preencha. Nunca commite o .env (bloqueado pelo pre-commit).
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=
OPENAI_API_KEY=

# API Go (services/api)
API_PORT=8080
API_LOG_LEVEL=info
API_READ_HEADER_TIMEOUT=5s
API_SHUTDOWN_TIMEOUT=15s
API_PROBE_TIMEOUT=2s
API_DOCS_ENABLED=true
# Origens do navegador autorizadas pelo CORS, separadas por vírgula (sem curinga nem caminho).
API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres (docker-compose). Use senhas fortes e URL-safe (letras, números, - e _):
# elas entram nas URLs de conexão dos serviços. Gere com: openssl rand -hex 24
POSTGRES_USER=agro_admin
POSTGRES_PASSWORD=
API_DB_MIGRATOR_PASSWORD=
API_DB_APP_PASSWORD=
LABEL_ADVISOR_DB_MIGRATOR_PASSWORD=
LABEL_ADVISOR_DB_APP_PASSWORD=

# Valores de negócio da API (opcionais; o docker-compose já aplica estes padrões).
# API_INVITATION_TTL=72h
# API_TRIAL_DURATION=336h
# API_LAST_ACCESS_INTERVAL=5m
# API_PAGE_SIZE_DEFAULT=20
# API_PAGE_SIZE_MAX=100

# Sessão do navegador da API (BFF, ADR 0015 D6). A chave cifra o refresh token no banco:
# base64 de 32 bytes aleatórios (gere com: openssl rand -base64 32). Obrigatória; nunca commite o valor.
API_SESSION_ENC_KEY=
# Rotação: aumente o id ao trocar a chave e mantenha as antigas em API_SESSION_ENC_OLD_KEYS="id:base64,id:base64".
# API_SESSION_ENC_KEY_ID=1
# API_SESSION_ENC_OLD_KEYS=
# Os cookies de sessão são sempre Secure (não há opção). Navegadores tratam http://localhost como
# contexto seguro, exceto o Safari, onde o login local por http não persiste o cookie.
# API_SESSION_TTL=168h
# API_SESSION_FLOW_TTL=10m
# API_OIDC_TIMEOUT=10s

# Pool de conexões da API (opcionais; o docker-compose já monta API_DATABASE_URL com o papel api_app).
# API_DB_MAX_CONNS=10
# API_DB_MIN_CONNS=2
# API_DB_STATEMENT_TIMEOUT=15s
# API_SESSION_TOUCH_INTERVAL=1m

# Portas no host (docker-compose); mude se já estiverem em uso.
POSTGRES_HOST_PORT=5433
# A porta da API no host entra na redirect_uri do Keycloak (padrão http://localhost:<API_HOST_PORT>/auth/callback):
# mudou aqui, rode `make keycloak` de novo, ou fixe AGENTES_AGRO_API_URL abaixo.
API_HOST_PORT=8080
SPRAY_PLANNER_HOST_PORT=8001
LABEL_ADVISOR_HOST_PORT=8003
WEB_HOST_PORT=3000

# Se mudar WEB_HOST_PORT, ajuste também API_CORS_ALLOWED_ORIGINS.
# O front (agro-web) usa API_HOST_PORT para montar a URL da API no navegador.
#
# Front e sessão (ADR 0015): o login é o do Keycloak e a sessão é o cookie HttpOnly `agro_session` da API.
# Abra o front em http://localhost:<WEB_HOST_PORT> (não 127.0.0.1): o cookie é do host da API (localhost)
# e só viaja same-site. Origens e porta do front precisam estar em API_CORS_ALLOWED_ORIGINS.
# NUXT_PUBLIC_API_MOCK=true             tudo em memória, com formulário de senha (só `make dev`; nunca em produção)
# NUXT_PUBLIC_API_MOCK_PENDING=true     API real e mock só nos endpoints ainda `planned` (só `make dev`); padrão do compose
# NUXT_PUBLIC_ACCOUNT_URL=              página da conta no Keycloak, onde a senha é trocada (padrão: KEYCLOAK_URL/realms/<realm>/account)

# Agentes Python
SPRAY_PLANNER_LOG_LEVEL=INFO
LABEL_ADVISOR_LOG_LEVEL=INFO

# Keycloak compartilhado (projeto infra-docker; ADR 0015). Usado por `make keycloak`.
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=inceres
# Conta do realm master que administra o realm (em desenvolvimento, a do infra-docker).
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
# Segredos dos clients, com no mínimo 32 caracteres. `make keycloak` gera os que faltarem.
KEYCLOAK_AGENTES_AGRO_CLIENT_SECRET=
KEYCLOAK_PROVISIONER_CLIENT_SECRET=
# O container da API chama o Keycloak em http://keycloak:8080 (rede inceres-infra) e valida o emissor público abaixo
# (padrão http://localhost:8180). Ajuste só se o endereço que o navegador usa for outro.
# KEYCLOAK_ISSUER_URL=http://localhost:8180
# KEYCLOAK_PROVISIONER_CLIENT_ID=agentes-agro-provisioner
# KEYCLOAK_AGENTES_AGRO_CLIENT_ID=agentes-agro
# URLs do produto que o Keycloak precisa conhecer (redirect_uri, origem do front, back-channel logout).
# Em branco, valem os padrões: http://localhost:<API_HOST_PORT>, http://agro-api:8080 e http://localhost:<WEB_HOST_PORT>.
# AGENTES_AGRO_WEB_URL também é lida pela API: o /auth/callback redireciona o navegador para <web>/<return_to>
# (ou <web>/login?error=<código>). Sem valor na API (fora do compose), o redirecionamento fica relativo.
# Fora do desenvolvimento local, preencha com as URLs públicas (https).
AGENTES_AGRO_API_URL=
AGENTES_AGRO_API_INTERNAL_URL=
AGENTES_AGRO_WEB_URL=
# Realm que autentica o script quando não é o master (padrão: master).
# KEYCLOAK_AUTH_REALM=master
# Alternativa ao usuário e senha do master: conta de serviço com permissão de administrar o realm.
# KEYCLOAK_ADMIN_CLIENT_ID=
# KEYCLOAK_ADMIN_CLIENT_SECRET=
# Senhas dos 3 usuários de desenvolvimento de `make keycloak-seed` (um por papel; só localhost).
# Mínimo de 8 caracteres, com número e letra minúscula (política do realm). Nunca commite valores reais.
KEYCLOAK_SEED_PASSWORD_SUPER_ADMIN=
KEYCLOAK_SEED_PASSWORD_ADMIN=
KEYCLOAK_SEED_PASSWORD_PLANNING_OPERATOR=
